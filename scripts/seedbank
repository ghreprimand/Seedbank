#!/usr/bin/env bash
# Seedbank launcher - start|stop|restart|status|logs

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SEEDBANK_DIR="${SEEDBANK_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
CLIENT_PORT_ENV_SET="${SEEDBANK_CLIENT_PORT+x}"
SERVER_PORT_ENV_SET="${SEEDBANK_SERVER_PORT+x}"
CLIENT_PORT="${SEEDBANK_CLIENT_PORT:-5173}"
SERVER_PORT="${SEEDBANK_SERVER_PORT:-4800}"
URL="http://localhost:${CLIENT_PORT}"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/seedbank"
CLIENT_PID_FILE="${CACHE_DIR}/client.pid"
SERVER_PID_FILE="${CACHE_DIR}/server.pid"
CLIENT_PORT_FILE="${CACHE_DIR}/client.port"
SERVER_PORT_FILE="${CACHE_DIR}/server.port"
LOG_FILE="${CACHE_DIR}/seedbank.log"
START_LOCK_DIR="${CACHE_DIR}/start.lock.d"
TRACE_FILE="${CACHE_DIR}/launcher-trace.log"
BROWSER_OPEN_STAMP_FILE="${CACHE_DIR}/last-browser-open"
BROWSER_OPEN_LOCK_DIR="${CACHE_DIR}/browser-open.lock.d"
BROWSER_OPEN_DEBOUNCE_SECONDS="${SEEDBANK_BROWSER_OPEN_DEBOUNCE_SECONDS:-3}"

mkdir -p "$CACHE_DIR"

if [[ -z "$CLIENT_PORT_ENV_SET" && -f "$CLIENT_PORT_FILE" && -f "$CLIENT_PID_FILE" ]]; then
  cached_pid=$(cat "$CLIENT_PID_FILE" 2>/dev/null || echo "")
  if [[ -n "$cached_pid" ]] && kill -0 "$cached_pid" 2>/dev/null; then
    CLIENT_PORT=$(cat "$CLIENT_PORT_FILE" 2>/dev/null || echo "$CLIENT_PORT")
  fi
fi
if [[ -z "$SERVER_PORT_ENV_SET" && -f "$SERVER_PORT_FILE" && -f "$SERVER_PID_FILE" ]]; then
  cached_pid=$(cat "$SERVER_PID_FILE" 2>/dev/null || echo "")
  if [[ -n "$cached_pid" ]] && kill -0 "$cached_pid" 2>/dev/null; then
    SERVER_PORT=$(cat "$SERVER_PORT_FILE" 2>/dev/null || echo "$SERVER_PORT")
  fi
fi
URL="http://localhost:${CLIENT_PORT}"

trace() {
  printf '%s [pid=%d ppid=%d] %s\n' "$(date -Iseconds)" "$$" "$PPID" "$*" >> "$TRACE_FILE"
}

notify() {
  local title="$1"
  local body="${2:-}"
  local urgency="${3:-normal}"
  echo "[seedbank-launcher] $title${body:+: $body}" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a Seedbank -u "$urgency" "$title" "$body" 2>/dev/null || true
  elif [[ "$(uname -s)" == "Darwin" ]] && command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification \"${body//\"/\\\"}\" with title \"${title//\"/\\\"}\"" >/dev/null 2>&1 || true
  fi
}

port_in_use() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}$"
  elif command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
  else
    (exec 3<>/dev/tcp/127.0.0.1/"$port") 2>/dev/null && { exec 3<&-; exec 3>&-; return 0; } || return 1
  fi
}

pid_on_port() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltnp 2>/dev/null | awk -v p=":$port" '$4 ~ p {print $0}' | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2 || true
  elif command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -1 || true
  else
    echo ""
  fi
}

find_free_port() {
  local start="$1"
  local port="$start"
  local limit=$((start + 50))
  while [[ "$port" -lt "$limit" ]]; do
    if ! port_in_use "$port"; then
      echo "$port"
      return 0
    fi
    port=$((port + 1))
  done
  return 1
}

pid_is_seedbank() {
  local pid="$1"
  [[ -z "$pid" ]] && return 1

  if [[ -d "/proc/$pid" ]]; then
    local p="$pid" hops=0
    while [[ -n "$p" && "$p" -gt 1 && "$hops" -lt 8 ]]; do
      local cwd=""
      cwd=$(readlink "/proc/$p/cwd" 2>/dev/null || true)
      if [[ -n "$cwd" && "$cwd" == "$SEEDBANK_DIR"* ]]; then
        return 0
      fi
      if [[ -r "/proc/$p/cmdline" ]] && tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -Fq "$SEEDBANK_DIR"; then
        return 0
      fi
      p=$(sed -E 's/^[0-9]+ \([^)]*\) [A-Za-z] ([0-9]+).*/\1/' "/proc/$p/stat" 2>/dev/null || echo "")
      [[ "$p" =~ ^[0-9]+$ ]] || p=""
      hops=$((hops + 1))
    done
    return 1
  fi

  ps -p "$pid" -o command= 2>/dev/null | grep -Fq "$SEEDBANK_DIR"
}

kill_pid_file() {
  local pid_file="$1"
  [[ -f "$pid_file" ]] || return 0
  local pid
  pid=$(cat "$pid_file" 2>/dev/null || echo "")
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill -- -"$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    sleep 0.5
    kill -9 -- -"$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file"
}

reap_seedbank_ports() {
  local reaped=0
  for port in "$CLIENT_PORT" "$SERVER_PORT"; do
    local pid
    pid=$(pid_on_port "$port")
    if [[ -n "$pid" ]] && pid_is_seedbank "$pid"; then
      kill -- -"$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
      reaped=1
    fi
  done
  if [[ "$reaped" -eq 1 ]]; then
    sleep 1
    for port in "$CLIENT_PORT" "$SERVER_PORT"; do
      local pid
      pid=$(pid_on_port "$port")
      if [[ -n "$pid" ]] && pid_is_seedbank "$pid"; then
        kill -9 -- -"$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
      fi
    done
  fi
}

is_running() {
  local client_pid="" server_pid=""
  [[ -f "$CLIENT_PID_FILE" ]] && client_pid=$(cat "$CLIENT_PID_FILE" 2>/dev/null || echo "")
  [[ -f "$SERVER_PID_FILE" ]] && server_pid=$(cat "$SERVER_PID_FILE" 2>/dev/null || echo "")
  local cached_client_port="" cached_server_port=""
  [[ -f "$CLIENT_PORT_FILE" ]] && cached_client_port=$(cat "$CLIENT_PORT_FILE" 2>/dev/null || echo "")
  [[ -f "$SERVER_PORT_FILE" ]] && cached_server_port=$(cat "$SERVER_PORT_FILE" 2>/dev/null || echo "")
  if [[ -n "$client_pid" && -n "$server_pid" ]] \
    && [[ "${cached_client_port:-$CLIENT_PORT}" == "$CLIENT_PORT" ]] \
    && [[ "${cached_server_port:-$SERVER_PORT}" == "$SERVER_PORT" ]] \
    && kill -0 "$client_pid" 2>/dev/null \
    && kill -0 "$server_pid" 2>/dev/null; then
    return 0
  fi
  if port_in_use "$CLIENT_PORT" && port_in_use "$SERVER_PORT"; then
    local client_port_pid server_port_pid
    client_port_pid=$(pid_on_port "$CLIENT_PORT")
    server_port_pid=$(pid_on_port "$SERVER_PORT")
    pid_is_seedbank "$client_port_pid" && pid_is_seedbank "$server_port_pid"
    return
  fi
  return 1
}

ensure_port_available() {
  local var_name="$1" name="$2" allow_bump="$3"
  local port="${!var_name}"
  if ! port_in_use "$port"; then
    return 0
  fi
  local pid
  pid=$(pid_on_port "$port")
  if [[ -n "$pid" ]] && pid_is_seedbank "$pid"; then
    trace "port $port held by Seedbank pid $pid; reaping"
    reap_seedbank_ports
    return 0
  fi
  if [[ "$allow_bump" == "true" ]]; then
    local bumped
    bumped=$(find_free_port "$port") || {
      notify "Seedbank: no free $name port" "All ports near $port are busy" "critical"
      exit 1
    }
    notify "Seedbank: $name port busy" "Using $bumped instead of $port"
    trace "port bump $name $port -> $bumped (held by PID ${pid:-unknown})"
    printf -v "$var_name" '%s' "$bumped"
    URL="http://localhost:${CLIENT_PORT}"
    return 0
  fi
  notify "Seedbank: $name port busy" "Port $port is already in use${pid:+ by PID $pid}" "critical"
  local env_name="SEEDBANK_CLIENT_PORT"
  [[ "$name" == "server" ]] && env_name="SEEDBANK_SERVER_PORT"
  echo "Port $port is already in use${pid:+ by PID $pid}. Stop that process or set $env_name." >&2
  exit 1
}

install_if_needed() {
  if [[ ! -d "$SEEDBANK_DIR/node_modules" ]]; then
    notify "Seedbank setup" "Installing npm dependencies"
    (cd "$SEEDBANK_DIR" && npm install) >> "$LOG_FILE" 2>&1
  fi
}

build_if_needed() {
  local client_output="$SEEDBANK_DIR/client/dist/index.html"
  local server_output="$SEEDBANK_DIR/server/dist/server/src/index.js"
  local build_reason=""

  if [[ ! -f "$client_output" || ! -f "$server_output" ]]; then
    build_reason="missing dist output"
  elif sources_newer_than "$client_output" \
    "package.json" \
    "package-lock.json" \
    "client/package.json" \
    "client/index.html" \
    "client/vite.config.ts" \
    "client/tsconfig.json" \
    "client/tsconfig.app.json" \
    "client/tsconfig.node.json" \
    "client/src" \
    "client/public" \
    "shared"; then
    build_reason="client sources changed"
  elif sources_newer_than "$server_output" \
    "package.json" \
    "package-lock.json" \
    "server/package.json" \
    "server/tsconfig.json" \
    "server/src" \
    "shared"; then
    build_reason="server sources changed"
  fi

  if [[ -n "$build_reason" ]]; then
    notify "Seedbank setup" "Building $build_reason"
    (cd "$SEEDBANK_DIR" && npm run build) >> "$LOG_FILE" 2>&1
  fi
}

sources_newer_than() {
  local output="$1"
  shift

  [[ -e "$output" ]] || return 0

  local relative_path path newer_file
  for relative_path in "$@"; do
    path="$SEEDBANK_DIR/$relative_path"
    [[ -e "$path" ]] || continue

    if [[ -d "$path" ]]; then
      newer_file=$(find "$path" \
        \( -path '*/node_modules' -o -path '*/.git' -o -path '*/dist' \) -prune \
        -o -type f -newer "$output" -print -quit)
      [[ -n "$newer_file" ]] && return 0
    elif [[ "$path" -nt "$output" ]]; then
      return 0
    fi
  done

  return 1
}

launch_process() {
  local pid_file="$1"
  shift
  if command -v setsid >/dev/null 2>&1; then
    nohup setsid "$@" >> "$LOG_FILE" 2>&1 &
  else
    nohup "$@" >> "$LOG_FILE" 2>&1 &
  fi
  echo $! > "$pid_file"
}

wait_ready() {
  local tries="${1:-60}"
  for _ in $(seq 1 "$tries"); do
    local server_ready=1 client_ready=1
    if command -v curl >/dev/null 2>&1; then
      curl -fsS "http://localhost:${SERVER_PORT}/api/health" >/dev/null 2>&1 && server_ready=0
      curl -fsS "$URL" >/dev/null 2>&1 && client_ready=0
    else
      port_in_use "$SERVER_PORT" && server_ready=0
      port_in_use "$CLIENT_PORT" && client_ready=0
    fi
    [[ "$server_ready" -eq 0 && "$client_ready" -eq 0 ]] && return 0
    sleep 0.5
  done
  return 1
}

open_browser() {
  local now=0 last_opened=0
  if ! mkdir "$BROWSER_OPEN_LOCK_DIR" 2>/dev/null; then
    trace "browser open skipped url=$URL reason=lock-held"
    return 0
  fi

  now=$(date +%s)
  if [[ -f "$BROWSER_OPEN_STAMP_FILE" ]]; then
    last_opened=$(cat "$BROWSER_OPEN_STAMP_FILE" 2>/dev/null || echo 0)
  fi
  if [[ "$last_opened" =~ ^[0-9]+$ ]] && (( now - last_opened < BROWSER_OPEN_DEBOUNCE_SECONDS )); then
    trace "browser open skipped url=$URL debounce=${BROWSER_OPEN_DEBOUNCE_SECONDS}s"
    notify "Seedbank already open" "$URL"
    rmdir "$BROWSER_OPEN_LOCK_DIR" 2>/dev/null || true
    return 0
  fi

  echo "$now" > "$BROWSER_OPEN_STAMP_FILE"
  trace "browser open url=$URL"
  if open_with_browser_command "$URL"; then
    rmdir "$BROWSER_OPEN_LOCK_DIR" 2>/dev/null || true
    return 0
  fi

  if [[ "$(uname -s)" == "Darwin" ]] && command -v open >/dev/null 2>&1; then
    open "$URL" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$URL" >/dev/null 2>&1 &
  else
    notify "Seedbank ready" "Open $URL"
  fi
  rmdir "$BROWSER_OPEN_LOCK_DIR" 2>/dev/null || true
}

shell_quote() {
  printf '%q' "$1"
}

desktop_entry_path() {
  local desktop_id="$1"
  local candidate=""
  for base in \
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
    "$HOME/.local/share/applications" \
    /usr/local/share/applications \
    /usr/share/applications; do
    candidate="$base/$desktop_id"
    if [[ -f "$candidate" ]]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

default_browser_desktop_entry() {
  local desktop_id=""
  desktop_id=$(mimeapps_default_desktop_id || true)
  if [[ -z "$desktop_id" ]] && command -v xdg-mime >/dev/null 2>&1; then
    desktop_id=$(xdg-mime query default x-scheme-handler/http 2>/dev/null | awk 'NF { print; exit }')
  fi
  [[ -n "$desktop_id" ]] || return 1
  desktop_entry_path "$desktop_id"
}

mimeapps_default_desktop_id() {
  local file=""
  for file in \
    "$HOME/.config/mimeapps.list" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications/mimeapps.list" \
    "$HOME/.local/share/applications/mimeapps.list"; do
    [[ -f "$file" ]] || continue
    awk '
      /^\[/ { section = $0 }
      section == "[Default Applications]" && /^x-scheme-handler\/http=/ {
        sub(/^x-scheme-handler\/http=/, "")
        split($0, candidates, ";")
        for (i = 1; i <= length(candidates); i++) {
          if (candidates[i] != "") {
            print candidates[i]
            exit
          }
        }
      }
    ' "$file" | head -n 1
    return 0
  done
  return 1
}

open_with_desktop_entry() {
  local url="$1"
  local entry="$2"
  local exec_line="" command_line="" quoted_url=""
  exec_line=$(grep -m 1 '^Exec=' "$entry" 2>/dev/null || true)
  exec_line="${exec_line#Exec=}"
  [[ -n "$exec_line" ]] || return 1

  quoted_url=$(shell_quote "$url")
  command_line="$exec_line"
  if [[ "$command_line" == *%* ]]; then
    command_line="${command_line//%U/$quoted_url}"
    command_line="${command_line//%u/$quoted_url}"
    command_line="${command_line//%F/$quoted_url}"
    command_line="${command_line//%f/$quoted_url}"
    command_line="${command_line//%D/}"
    command_line="${command_line//%d/}"
    command_line="${command_line//%N/}"
    command_line="${command_line//%n/}"
    command_line="${command_line//%i/}"
    command_line="${command_line//%c/Seedbank}"
    command_line="${command_line//%k/}"
    command_line="${command_line//%v/}"
    command_line="${command_line//%m/}"
    command_line="${command_line//%%/%}"
  else
    command_line="$command_line $quoted_url"
  fi

  trace "browser open via desktop entry=$(basename "$entry")"
  bash -lc "$command_line" >/dev/null 2>&1 &
  return 0
}

open_with_browser_command() {
  local url="$1"
  local entry=""

  if [[ -n "${SEEDBANK_BROWSER:-}" ]]; then
    trace "browser open via SEEDBANK_BROWSER"
    "${SEEDBANK_BROWSER}" "$url" >/dev/null 2>&1 &
    return 0
  fi

  entry=$(default_browser_desktop_entry || true)
  if [[ -n "$entry" ]] && open_with_desktop_entry "$url" "$entry"; then
    return 0
  fi

  return 1
}

start() {
  trace "start ENTER dir=$SEEDBANK_DIR client=$CLIENT_PORT server=$SERVER_PORT"
  if ! mkdir "$START_LOCK_DIR" 2>/dev/null; then
    notify "Seedbank start already in progress"
    return 0
  fi
  trap 'rmdir "$START_LOCK_DIR" 2>/dev/null || true' RETURN

  mkdir -p "$CACHE_DIR"
  {
    echo ""
    echo "=== $(date -Iseconds) - seedbank start (client=$CLIENT_PORT server=$SERVER_PORT) ==="
  } >> "$LOG_FILE"

  if is_running; then
    notify "Seedbank already running" "$URL"
    open_browser
    return 0
  fi

  ensure_port_available CLIENT_PORT "client" "true"
  ensure_port_available SERVER_PORT "server" "false"
  install_if_needed
  build_if_needed

  cd "$SEEDBANK_DIR"
  notify "Starting Seedbank" "$URL"
  launch_process "$SERVER_PID_FILE" env PORT="$SERVER_PORT" npm run start -w server
  launch_process "$CLIENT_PID_FILE" env VITE_SEEDBANK_API_URL="http://localhost:${SERVER_PORT}" npm run preview -w client -- --host 127.0.0.1 --port "$CLIENT_PORT" --strictPort
  echo "$SERVER_PORT" > "$SERVER_PORT_FILE"
  echo "$CLIENT_PORT" > "$CLIENT_PORT_FILE"

  if ! wait_ready 80; then
    notify "Seedbank start failed" "See $LOG_FILE" "critical"
    exit 1
  fi

  notify "Seedbank ready" "$URL"
  open_browser
}

stop() {
  trace "stop ENTER"
  kill_pid_file "$CLIENT_PID_FILE"
  kill_pid_file "$SERVER_PID_FILE"
  reap_seedbank_ports
  rm -f "$CLIENT_PID_FILE" "$SERVER_PID_FILE" "$CLIENT_PORT_FILE" "$SERVER_PORT_FILE"
  rm -f "$BROWSER_OPEN_STAMP_FILE"
  rmdir "$BROWSER_OPEN_LOCK_DIR" 2>/dev/null || true
  notify "Seedbank stopped"
}

status() {
  if is_running; then
    echo "Seedbank: RUNNING"
    echo "  URL:         $URL"
    echo "  API:         http://localhost:${SERVER_PORT}"
    echo "  cache:       $CACHE_DIR"
    echo "  log:         $LOG_FILE"
    [[ -f "$CLIENT_PID_FILE" ]] && echo "  client PID:  $(cat "$CLIENT_PID_FILE")"
    [[ -f "$SERVER_PID_FILE" ]] && echo "  server PID:  $(cat "$SERVER_PID_FILE")"
  else
    echo "Seedbank: STOPPED"
    echo "  cache:       $CACHE_DIR"
    echo "  log:         $LOG_FILE"
  fi
  for port in "$CLIENT_PORT" "$SERVER_PORT"; do
    if port_in_use "$port"; then
      local pid=""
      pid=$(pid_on_port "$port")
      echo "  port $port:  LISTENING${pid:+ (PID $pid)}"
    else
      echo "  port $port:  free"
    fi
  done
}

logs() {
  if [[ ! -f "$LOG_FILE" ]]; then
    echo "No log at $LOG_FILE yet"
    exit 0
  fi
  tail -n "${2:-100}" -f "$LOG_FILE"
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  status) status ;;
  logs) logs "$@" ;;
  *)
    cat >&2 <<EOF
Usage: $0 {start|stop|restart|status|logs}

Environment:
  SEEDBANK_DIR           Project directory (default: parent of scripts/)
  SEEDBANK_CLIENT_PORT   Vite dev server port (default: 5173)
  SEEDBANK_SERVER_PORT   Express API port (default: 4800)
EOF
    exit 1
    ;;
esac
